FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=replace-this-with-a-long-random-secret
JWT_SECRET_KEY=replace-this-with-another-long-random-secret
# For quick local development, SQLite is used by default.
# For PostgreSQL, uncomment and update:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/credit_bureau
DATABASE_URL=sqlite:///credit_bureau.db
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
BUREAU_MODE=mock
